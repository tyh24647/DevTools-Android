{
  "manifest_version": 3,
  "name": "DevTools \u2014 Browser Console Preview",
  "version": "0.3.0",
  "description": "Open an on-page developer console in the current Firefox tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "action": {
    "default_title": "DevTools",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "devtools-preview@tyh24647.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "auto.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
